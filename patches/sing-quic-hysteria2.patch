+func (c *Client) offerShared(ctx context.Context, waitAuth bool) (*clientQUICConnection, error) {
+	c.connAccess.Lock()
+	if conn := c.conn; conn != nil && !conn.active() {
+		c.conn = nil
+	}
+	if conn := c.conn; conn != nil && conn.active() {
+		c.connAccess.Unlock()
+		if !waitAuth {
+			return conn, nil
+		}
+		if err := conn.waitAuth(ctx); err != nil {
+			return nil, err
+		}
+		if !conn.active() {
+			return nil, E.New("connection closed")
+		}
+		return conn, nil
+	}
+	pending := c.pending
+	if pending == nil {
+		offerCtx := c.ctx
+		if offerCtx == nil {
+			offerCtx = context.Background()
+		}
+		offerCtx, cancel := common.ContextWithCancelCause(offerCtx)
+		pending = &clientOffer{
+			done:   make(chan struct{}),
+			dialed: make(chan struct{}),
+			cancel: cancel,
+		}
+		c.pending = pending
+		go c.completeOffer(pending, offerCtx)
+	}
+	c.connAccess.Unlock()
+
+	if waitAuth {
+		select {
+		case <-pending.done:
+			if pending.err != nil {
+				return nil, pending.err
+			}
+			return pending.conn, nil
+		case <-ctx.Done():
+			return nil, context.Cause(ctx)
+		}
+	}
+	select {
+	case <-pending.dialed:
+	case <-ctx.Done():
+		return nil, context.Cause(ctx)
+	}
+	c.connAccess.Lock()
+	conn := pending.conn
+	err := pending.err
+	c.connAccess.Unlock()
+	if conn != nil && conn.active() {
+		return conn, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	select {
+	case <-pending.done:
+	case <-ctx.Done():
+		return nil, context.Cause(ctx)
+	}
+	c.connAccess.Lock()
+	conn = pending.conn
+	err = pending.err
+	c.connAccess.Unlock()
+	if conn != nil && conn.active() {
+		return conn, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	return nil, E.New("hysteria2 dial failed")
+}
